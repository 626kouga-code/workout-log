# ローカル開発用の環境変数。`cp .env.example .env` でコピーして使う。
# 値は docker-compose.yml のサービスに合わせてある。

# MySQL
DATABASE_URL="mysql://workout:workout@localhost:3306/workout_log"
# 結合テスト用（npm test で使う。#3 以降）
DATABASE_URL_TEST="mysql://workout:workout@localhost:3306/workout_log_test"

# S3（ローカルは S3Mock。#21 で使う）
S3_ENDPOINT="http://localhost:9090"
S3_BUCKET="workout-log-local"
S3_REGION="ap-northeast-1"

# メール送信（ローカルは Mailpit。受信箱は http://localhost:8025。#6 で使う）
SMTP_HOST="localhost"
SMTP_PORT="1025"
MAIL_FROM="Workout Log <no-reply@workout-log.local>"
