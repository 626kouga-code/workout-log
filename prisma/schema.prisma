// データモデルは docs/05_data-model.md。
// モデル名は PascalCase、テーブル名・列名は snake_case（@@map / @map で対応させる）。
// テーブルは使う Issue（#5 の users から）で追加する。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---- ユーザー・認証 ----

/// ユーザー（users）。メールアドレス・ユーザーIDは、照合順序により大文字小文字を区別せず一意
model User {
  id              String    @id @db.Char(36)
  email           String    @unique @db.VarChar(254)
  passwordHash    String    @map("password_hash") @db.VarChar(100)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.DateTime(3)
  handle          String    @unique @db.VarChar(15)
  displayName     String    @map("display_name") @db.VarChar(50)
  bio             String    @default("") @db.VarChar(160)
  avatarKey       String?   @map("avatar_key") @db.VarChar(255)
  targetWeightKg  Decimal?  @map("target_weight_kg") @db.Decimal(5, 1)
  keepScreenAwake Boolean   @default(true) @map("keep_screen_awake")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  sessions           Session[]
  emailVerifications EmailVerification[]
  exercises          Exercise[]
  workouts           Workout[]
  appliedChanges     AppliedChange[]
  deletedRecords     DeletedRecord[]

  @@map("users")
}

/// セッション（sessions）。Cookie に入れるトークンそのものは保存せず、SHA-256 のハッシュだけを持つ
model Session {
  id        String   @id @db.Char(36)
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Char(36)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// メールアドレス確認（email_verifications）。確認リンクのトークンそのものは保存せず、SHA-256 のハッシュだけを持つ（F-02）
model EmailVerification {
  id        String    @id @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

// ---- トレーニング ----

/// 種目（exercises）。user_id が NULL ならプリセット（全員が使える種目。シードで投入する）
/// 部位・種別は MySQL の ENUM 型にせず文字列で持ち、値はアプリ側（src/lib/exercise.ts）で縛る
model Exercise {
  id        String    @id @db.Char(36)
  userId    String?   @map("user_id") @db.Char(36)
  name      String    @db.VarChar(30)
  bodyPart  String    @map("body_part") @db.VarChar(20)
  kind      String    @db.VarChar(20)
  hiddenAt  DateTime? @map("hidden_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@unique([userId, name])
  @@index([userId])
  @@map("exercises")
}

/// ワークアウト（workouts）。1 回のトレーニング。ID は端末で作った UUIDv7（F-16）
model Workout {
  id              String    @id @db.Char(36)
  userId          String    @map("user_id") @db.Char(36)
  /// 日本時間の日付
  performedOn     DateTime  @map("performed_on") @db.Date
  startedAt       DateTime  @map("started_at") @db.DateTime(3)
  /// NULL なら記録中（1 ユーザーにつき 1 件まで。同期の処理で確かめる）
  finishedAt      DateTime? @map("finished_at") @db.DateTime(3)
  note            String    @default("") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  /// 端末で最後に変更した時刻。複数の端末で変えたとき、新しいほうを採用する
  clientUpdatedAt DateTime  @map("client_updated_at") @db.DateTime(3)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  @@index([userId, performedOn])
  @@index([userId, finishedAt])
  @@map("workouts")
}

/// ワークアウトの種目（workout_exercises）。並び順は一意にしない（並べ替えの途中で一時的に重なるため）
model WorkoutExercise {
  id              String   @id @db.Char(36)
  workoutId       String   @map("workout_id") @db.Char(36)
  exerciseId      String   @map("exercise_id") @db.Char(36)
  sortOrder       Int      @map("sort_order") @db.SmallInt
  restSeconds     Int      @default(90) @map("rest_seconds") @db.SmallInt
  clientUpdatedAt DateTime @map("client_updated_at") @db.DateTime(3)

  workout  Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  /// 記録で使っている種目は削除できない（F-11）
  exercise Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets     WorkoutSet[]

  @@index([workoutId, sortOrder])
  @@index([exerciseId])
  @@map("workout_exercises")
}

/// セット（workout_sets）。種別ごとにどの項目を使うかは、アプリ側で検証する
model WorkoutSet {
  id                String    @id @db.Char(36)
  workoutExerciseId String    @map("workout_exercise_id") @db.Char(36)
  sortOrder         Int       @map("sort_order") @db.SmallInt
  weightKg          Decimal?  @map("weight_kg") @db.Decimal(6, 2)
  reps              Int?      @db.SmallInt
  durationSeconds   Int?      @map("duration_seconds")
  distanceM         Int?      @map("distance_m")
  completedAt       DateTime? @map("completed_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  clientUpdatedAt   DateTime  @map("client_updated_at") @db.DateTime(3)

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId, sortOrder])
  @@map("workout_sets")
}

/// 反映済みの変更（applied_changes）。同じ変更が二重に送られても 2 回反映しないために覚えておく（7 日で消す）
model AppliedChange {
  changeId  String   @id @map("change_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  appliedAt DateTime @map("applied_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, appliedAt])
  @@map("applied_changes")
}

/// 削除の記録（deleted_records）。消したものへの遅れて届いた更新で、復活させないために覚えておく（7 日で消す）
model DeletedRecord {
  /// workout・workoutExercise・set
  entity    String   @db.VarChar(20)
  id        String   @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  deletedAt DateTime @map("deleted_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([entity, id])
  @@index([userId, deletedAt])
  @@map("deleted_records")
}
