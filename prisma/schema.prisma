// データモデルは docs/05_data-model.md。
// モデル名は PascalCase、テーブル名・列名は snake_case（@@map / @map で対応させる）。
// テーブルは使う Issue（#5 の users から）で追加する。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---- ユーザー・認証 ----

/// ユーザー（users）。メールアドレス・ユーザーIDは、照合順序により大文字小文字を区別せず一意
model User {
  id              String    @id @db.Char(36)
  email           String    @unique @db.VarChar(254)
  passwordHash    String    @map("password_hash") @db.VarChar(100)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.DateTime(3)
  handle          String    @unique @db.VarChar(15)
  displayName     String    @map("display_name") @db.VarChar(50)
  bio             String    @default("") @db.VarChar(160)
  avatarKey       String?   @map("avatar_key") @db.VarChar(255)
  targetWeightKg  Decimal?  @map("target_weight_kg") @db.Decimal(5, 1)
  keepScreenAwake Boolean   @default(true) @map("keep_screen_awake")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  sessions Session[]

  @@map("users")
}

/// セッション（sessions）。Cookie に入れるトークンそのものは保存せず、SHA-256 のハッシュだけを持つ
model Session {
  id        String   @id @db.Char(36)
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Char(36)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
